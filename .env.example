# .env.example — Dental Clinic Staff App
# Copy this file to .env and fill in your Firebase project credentials.
# Get these values from: Firebase Console → Project Settings → Your apps
#
# For LOCAL DEVELOPMENT with the Firebase emulator, the app only requires
# FIREBASE_WEB_API_KEY, FIREBASE_WEB_APP_ID, and FIREBASE_MESSAGING_SENDER_ID.
# The emulator is started with: firebase emulators:start --project=<your-project-id>

# ---------- Firebase — Web (required for Flutter Web) ----------
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_APP_ID=your-web-app-id
FIREBASE_WEB_MEASUREMENT_ID=your-measurement-id

# ---------- Firebase — Shared across all platforms ----------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ---------- Firebase — Android (optional, only for Android builds) ----------
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=your-android-app-id

# ---------- Firebase — iOS / macOS (optional, only for iOS/macOS builds) ----------
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=your-ios-app-id
FIREBASE_IOS_BUNDLE_ID=com.yourcompany.yourapp

# ---------- Firebase — Windows (optional, only for Windows builds) ----------
FIREBASE_WINDOWS_API_KEY=your-windows-api-key
FIREBASE_WINDOWS_APP_ID=your-windows-app-id
FIREBASE_WINDOWS_MEASUREMENT_ID=your-windows-measurement-id
