# functions/.env.example — Cloud Functions / Express server environment variables
# Copy this file to functions/.env and fill in your credentials.
#
# IMPORTANT: functions/.env is gitignored and must never be committed.
# This example file IS committed and serves as the setup reference.

# ---------- Express Server (Render / local) ----------
# Port the server listens on. Render injects $PORT automatically; local dev defaults to 8080.
PORT=8080
NODE_ENV=production

# ---------- Firebase Service Account ----------
# Required when running the Express server OUTSIDE Firebase Cloud Functions
# (i.e., on Render or any other external Node.js host).
#
# How to generate:
#   1. Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → download the .json file
#   3. Paste the entire JSON content as a single-line string below.
#
# NEVER commit this value. It is git-ignored via functions/.env.
# Leave this blank when running locally with Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# ---------- Brevo Transactional Email ----------
# Get your API key at: https://app.brevo.com/settings/keys/api
#
# If BREVO_API_KEY is absent or starts with "mock", the server
# runs in dev-mock mode — emails are logged to the console instead of sent.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Your Clinic Name
